#!/usr/bin/env bash
# Předvyplní commit zprávu "<typ>(#<issue>): " podle názvu aktuální větve.
#   větev feat/42-neco  ->  "feat(#42): "
#   větev bug/7-oprava   ->  "bug(#7): "
# Ostatní větve (no-issue/..., dev) se nechají být — napíšeš zprávu ručně.
#
# Aktivace (jednorázově v klonu):  git config core.hooksPath .githooks
set -eu

MSG_FILE="$1"
SRC="${2:-}"

# Jen když se otevírá editor pro NOVOU zprávu (ne git commit -m / merge / squash / --amend)
case "$SRC" in
  ""|template) ;;
  *) exit 0 ;;
esac

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

if [[ "$branch" =~ ^(feat|bug)/([0-9]+) ]]; then
  type="${BASH_REMATCH[1]}"
  issue="${BASH_REMATCH[2]}"
  prefix="${type}(#${issue}): "
  # nepřidávej prefix podruhé
  if ! head -n1 "$MSG_FILE" | grep -q "^${type}(#${issue})"; then
    tmp="$(mktemp)"
    printf '%s\n' "$prefix" > "$tmp"
    cat "$MSG_FILE" >> "$tmp"
    mv "$tmp" "$MSG_FILE"
  fi
fi
